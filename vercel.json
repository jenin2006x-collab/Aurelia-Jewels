{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/", "destination": "/aurelia-final/index.html" },
    { "source": "/admin", "destination": "/aurelia-final/admin/index.html" },
    { "source": "/admin/", "destination": "/aurelia-final/admin/index.html" },
    { "source": "/(.*)", "destination": "/aurelia-final/$1" }
  ]
}
